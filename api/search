rchitecture-39","page_id":"/docs/dev/architecture","tags":[],"type":"text","url":"/docs/dev/architecture#主链路","content":"插件的调用经 HostApiVTable 落到 HostRuntime，再翻译成 TdClient 的 send 或 execute；接收循环把回来的东西分成 Update（分发）与 Response（回投）两条路。"},"135":{"id":"/docs/dev/architecture-40","page_id":"/docs/dev/architecture","tags":[],"type":"text","url":"/docs/dev/architecture#主链路","content":"插件"},"136":{"id":"/docs/dev/architecture-41","page_id":"/docs/dev/architecture","tags":[],"type":"text","url":"/docs/dev/architecture#主链路","content":"on / invoke / emit / td_invoke / td_execute / get_config / …"},"137":{"id":"/docs/dev/architecture-42","page_id":"/docs/dev/architecture","tags":[],"type":"text","url":"/docs/dev/architecture#主链路","content":"HostApiVTable"},"138":{"id":"/docs/dev/architecture-43","page_id":"/docs/dev/architecture","tags":[],"type":"text","url":"/docs/dev/architecture#主链路","content":"20 个函数指针，首参一律是 host，全是 Option"},"139":{"id":"/docs/dev/architecture-44","page_id":"/docs/dev/architecture","tags":[],"type":"text","url":"/docs/dev/architecture#主链路","content":"HostRuntime"},"140":{"id":"/docs/dev/architecture-45","page_id":"/docs/dev/architecture","tags":[],"type":"text","url":"/docs/dev/architecture#主链路","content":"翻译成事件总线 / 服务容器 / 工具表 / 中间件管线 / TdClient"},"141":{"id":"/docs/dev/architecture-46","page_id":"/docs/dev/architecture","tags":[],"type":"text","url":"/docs/dev/architecture#主链路","content":"发请求"},"142":{"id":"/docs/dev/architecture-47","page_id":"/docs/dev/architecture","tags":[],"type":"text","url":"/docs/dev/architecture#主链路","content":"同步执行"},"143":{"id":"/docs/dev/architecture-48","page_id":"/docs/dev/architecture","tags":[],"type":"text","url":"/docs/dev/architecture#主链路","content":"TdClient::send"},"144":{"id":"/docs/dev/architecture-49","page_id":"/docs/dev/architecture","tags":[],"type":"text","url":"/docs/dev/architecture#主链路","content":"注入 @extra；没接 TDLib 就留档 + 合成请求号"},"145":{"id":"/docs/dev/architecture-50","page_id":"/docs/dev/architecture","tags":[